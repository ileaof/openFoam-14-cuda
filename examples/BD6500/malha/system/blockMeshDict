FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// Malha de fundo para o snappyHexMesh (cubos de 1,5 mm); Z0, Z1 e NZ trocados por malha.sh

x0 -0.0465; x1 0.0465; n 62;
z0 Z0; z1 Z1; nz NZ;

vertices
(
    ($x0 $x0 $z0) ($x1 $x0 $z0) ($x1 $x1 $z0) ($x0 $x1 $z0)
    ($x0 $x0 $z1) ($x1 $x0 $z1) ($x1 $x1 $z1) ($x0 $x1 $z1)
);

blocks ( hex (0 1 2 3 4 5 6 7) ($n $n $nz) simpleGrading (1 1 1) );

boundary
(
    fundo { type patch; faces ((0 3 2 1) (4 5 6 7) (0 1 5 4) (1 2 6 5) (2 3 7 6) (3 0 4 7)); }
);

