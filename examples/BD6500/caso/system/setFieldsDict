FoamFile
{
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// Estado em -338 (admissao aberta): cilindro com gas residual (padrao dos campos: 100 kPa, 700 K),
// duto de admissao com ar fresco, duto de escape com gas de escape.

defaultFieldValues ();

zones
{
    dutoAdmissao
    {
        type        box;
        zoneType    cell;
        min         (-0.05 -0.05 0.0);
        max         ( 0.0   0.05 0.06);
        values
        {
            T   308.15;
            p   100000;
        }
    }
    dutoEscape
    {
        type        box;
        zoneType    cell;
        min         ( 0.0  -0.05 0.0);
        max         ( 0.05  0.05 0.06);
        values
        {
            T   700;
            p   105000;
        }
    }
}

