FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvConstraints;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Protecao contra instabilidade local na descarga do escape: na esteira do prato da valvula de
// escape, uma celula entrou em realimentacao (p -> 5 kPa, rho -> 0,03 kg/m3, |U| -> 750 m/s e
// subindo) e o passo de tempo caiu a 1e-11 s. Limites bem fora da faixa fisica do motor
// (p minima fisica ~80 kPa na aspiracao; T entre 308 K na entrada e ~2500 K na combustao).

limitp
{
    type            limitPressure;
    min             2e4;
    max             2e7;
}

limitT
{
    type            limitTemperature;
    cellZone        all;
    min             250;
    max             3500;
}

limitU
{
    type            limitMag;
    cellZone        all;
    field           U;
    max             1000;
}

