FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// Branco BD-6500, carga 60 %, 3311 rpm: ciclo completo 3D com valvulas e Wiebe (wiebepy case_006)

solver          fluid;

userTime
{
    type            engine;
    omega           3311 [rpm];
}

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         720;
deltaT          0.001;
writeControl    adjustableRunTime;
writeInterval   10;
writeFormat     binary;
writePrecision  10;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;
adjustTimeStep  yes;
maxCo           3;
maxDeltaT       0.05;

functions
{
    cilindro
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        select          cellZone;
        cellZone        cilindro;
        operation       volAverage;
        fields          (p T);
    }
    massaCilindro
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        select          cellZone;
        cellZone        cilindro;
        operation       volIntegrate;
        fields          (rho);
    }
    vazoes
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        select          patches;
        patches         (inlet outlet);
        operation       sum;
        fields          (phi);
    }
}

