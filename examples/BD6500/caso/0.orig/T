FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}

// paredes do cilindro e valvulas 440 K (como no wiebepy); duto de admissao 320 K; duto de escape 600 K
dimensions      [0 0 0 1 0 0 0];
internalField   uniform 750;

boundaryField
{
    inlet       { type inletOutlet; inletValue uniform 308.15; value uniform 308.15; }
    outlet      { type inletOutlet; inletValue uniform 700; value uniform 700; }
    intakePort  { type fixedValue; value uniform 320; }
    exhaustPort { type fixedValue; value uniform 600; }
    // paredes com temperaturas tipicas de diesel em carga media (Heywood, cap. 12); com 440 K em
    // todas, a perda de calor perto do PMS era excessiva (pico -5,1 % contra -2,6 % com estes valores)
    piston      { type fixedValue; value uniform 560; }
    head        { type fixedValue; value uniform 500; }
    liner       { type fixedValue; value uniform 420; }
    ivHead      { type fixedValue; value uniform 520; }
    evHead      { type fixedValue; value uniform 750; }
    ivSeat      { type fixedValue; value uniform 500; }
    evSeat      { type fixedValue; value uniform 550; }
    ivStem      { type fixedValue; value uniform 450; }
    evStem      { type fixedValue; value uniform 650; }
}
