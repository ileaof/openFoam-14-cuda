FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);

boundaryField
{
    "(piston|ivHead|evHead|ivStem|evStem)" { type movingWallVelocity; value uniform (0 0 0); }
    "(liner|head|ivSeat|evSeat|intakePort|exhaustPort)" { type noSlip; }
    "(inlet|outlet)" { type pressureInletOutletVelocity; value uniform (0 0 0); }
}
