FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 1;

boundaryField
{
    ".*"             { type kqRWallFunction; value uniform 1; }
    "(inlet|outlet)" { type inletOutlet; inletValue uniform 1; value uniform 1; }
}
