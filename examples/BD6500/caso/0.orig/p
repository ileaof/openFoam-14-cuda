FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}

// coletor de admissao 100 kPa; coletor de escape 105 kPa (estimados); cilindro 100 kPa em -338 (admissao aberta)
dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 105000;

boundaryField
{
    inlet  { type totalPressure; p0 uniform 100000; value uniform 100000; }
    outlet { type totalPressure; p0 uniform 105000; value uniform 105000; }
    ".*"   { type zeroGradient; }
}
