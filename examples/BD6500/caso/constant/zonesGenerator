FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      zonesGenerator;
}

// cilindro = celulas abaixo do cabecote (z < 0); atualizada com o movimento e as trocas de malha
cilindro
{
    type        box;
    zoneType    cell;
    moveUpdate  true;
    min         (-0.05 -0.05 -0.1);
    max         ( 0.05  0.05  0.0);
}

