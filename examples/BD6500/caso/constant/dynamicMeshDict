FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// Branco BD-6500 (86 x 70 mm, biela 117,5 mm): pistao + 2 valvulas verticais, malhas trocadas por meshToMesh

mover
{
    type            multiValveEngine;
    libs            ("libfvMeshMoversMultiValveEngine.so");

    slidingPatches  (liner ivStem evStem intakePort exhaustPort);
    linerPatches    (liner);

    piston
    {
        patches             (piston);
        axis                (0 0 1);
        motion
        {
            type            crankConnectingRodMotion;
            conRodLength    0.1175;
            stroke          0.070;
        }
        movingFrozenLayerThickness  0;
        travelInterval              0.007;
        cosineScale                 1;
    }

    valves
    {
        iv
        {
            patches         (ivHead);
            axis            (0 0 1);
            movingFrozenLayerThickness  0;
            travelInterval              0.0005;
            cosineScale                 1;
            maxMotionDistance           0.025;
            minLift                     0.0015;
            motion
            {
                type                table;
                values              ( #include "$FOAM_CASE/constant/ivLift" );
                outOfBounds         repeat;
                interpolationScheme linear;
            }
        }
        ev
        {
            $iv;
            patches         (evHead);
            motion
            {
                $iv/motion;
                values              ( #include "$FOAM_CASE/constant/evLift" );
            }
        }
    }
}

topoChanger
{
    type    meshToMesh;
    libs    ("libmeshToMeshTopoChanger.so");
    times
    (
        #include "$FOAM_CASE/constant/meshTimes"
    );
    timeDelta       1e-6;
    repeat          720;
}

