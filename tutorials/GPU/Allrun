#!/bin/sh
cd ${0%/*} || exit 1    # Run from this directory

# Tutorials with the pressure solved on the GPU (AMGX, through libamgxFoam.so).
# Without the library (see cuda/README.md) they are skipped, so they do not
# break the OpenFOAM tutorial loop on machines without a GPU.

found=
for d in "$FOAM_USER_LIBBIN" "$FOAM_SITE_LIBBIN" "$FOAM_LIBBIN"
do
    [ -n "$d" ] && [ -f "$d/libamgxFoam.so" ] && found=yes
done

if [ -z "$found" ]
then
    echo "libamgxFoam.so not found: GPU tutorials skipped"
    exit 0
fi

for case in */
do
    [ -x "$case/Allrun" ] && ( cd "$case" && ./Allrun gpu )
done

