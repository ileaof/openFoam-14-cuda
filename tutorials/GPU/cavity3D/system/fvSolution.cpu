FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Critério só relativo (tolerance 0) para casar exatamente com o RELATIVE_INI da AMGX
solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       0;
        relTol          0.05;
    }

    pFinal
    {
        $p;
        relTol          0.001;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-05;
        relTol          0;
    }
}

PISO
{
    nCorrectors     2;
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
}

// ************************************************************************* //
