FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The GPU stopping criterion is in the JSON files: amgxpOptions (relative 0.05)
// and amgxpFinalOptions (relative 0.001). tolerance/relTol below are ignored.
solvers
{
    p
    {
        solver          amgx;
        amgx
        {
            dict p;
        }
        tolerance       0;
        relTol          0.05;
    }

    pFinal
    {
        solver          amgx;
        amgx
        {
            dict pFinal;
        }
        tolerance       0;
        relTol          0.001;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-05;
        relTol          0;
    }
}

PISO
{
    nCorrectors     2;
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
}

// ************************************************************************* //
